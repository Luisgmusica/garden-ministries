---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import { ui } from '@/i18n/ui';
import type { Locale } from '@/i18n/locales';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
const i = t.impact;
const icons = ['receipt', 'eye', 'file-lock', 'hand-heart'] as const;
---

<BaseLayout locale={locale} path="/impact" title={i.eyebrow} description={i.description}>
  <PageHero eyebrow={i.eyebrow} title={i.title} description={i.description} />
  <section class="bg-white py-16">
    <div class="container-page">
      <div class="grid gap-4 lg:grid-cols-4">
        {i.steps.map(([title, text], index) => (
          <article class="rounded-3xl border border-forest/10 p-6">
            <span class="grid size-11 place-items-center rounded-2xl bg-sage text-forest">
              <Icon name={icons[index]} class="size-5" />
            </span>
            <p class="mt-7 text-[10px] font-bold uppercase tracking-[0.18em] text-clay">0{index + 1}</p>
            <h2 class="mt-2 font-heading text-2xl font-semibold text-forest">{title}</h2>
            <p class="mt-3 text-sm leading-7 text-forest/65">{text}</p>
          </article>
        ))}
      </div>
      <div class="mt-12 grid gap-8 rounded-[2rem] bg-forest p-8 text-cream lg:grid-cols-[.8fr_1.2fr] lg:p-10">
        <div>
          <h2 class="font-heading text-4xl font-semibold">{i.standardTitle}</h2>
          <p class="mt-5 text-sm leading-7 text-cream/60">{i.note}</p>
        </div>
        <div class="grid gap-3 sm:grid-cols-2">
          {i.standards.map((item) => (
            <p class="flex items-center gap-3 rounded-2xl border border-cream/12 bg-white/5 px-4 py-4 text-sm">
              <span class="size-2 rounded-full bg-[#e6a98d]"></span>
              {item}
            </p>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

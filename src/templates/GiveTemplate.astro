---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import { ui } from '@/i18n/ui';
import type { Locale } from '@/i18n/locales';
import { missions } from '@/data/missions';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
const g = t.give;
---

<BaseLayout locale={locale} path="/give" title={g.eyebrow} description={g.description}>
  <PageHero eyebrow={g.eyebrow} title={g.title} description={g.description} />
  <section class="bg-white py-16">
    <div class="container-page grid max-w-5xl gap-7 lg:grid-cols-[1.15fr_.85fr]" id="give-form" data-general-label={g.general}>
      <div class="rounded-[2rem] border border-forest/10 bg-cream/55 p-6 sm:p-8">
        <fieldset>
          <legend class="text-xs font-bold uppercase tracking-[0.16em] text-forest/55">{g.frequency}</legend>
          <div class="mt-4 grid grid-cols-2 gap-3" role="group" data-group="frequency">
            <button type="button" data-value="one-time" class="give-toggle flex h-12 items-center justify-center gap-2 rounded-2xl border text-sm font-semibold transition" aria-pressed="true">
              {g.one}
            </button>
            <button type="button" data-value="monthly" class="give-toggle flex h-12 items-center justify-center gap-2 rounded-2xl border text-sm font-semibold transition" aria-pressed="false">
              <Icon name="repeat" class="size-4" />
              {g.monthly}
            </button>
          </div>
        </fieldset>

        <fieldset class="mt-8">
          <legend class="text-xs font-bold uppercase tracking-[0.16em] text-forest/55">{g.amount}</legend>
          <div class="mt-4 grid grid-cols-4 gap-2" data-group="amount-preset">
            {g.amounts.map((value, index) => (
              <button type="button" data-value={value} class="amount-toggle h-11 rounded-xl border text-sm font-semibold" aria-pressed={index === 0 ? 'true' : 'false'}>
                ${value}
              </button>
            ))}
          </div>
          <label class="mt-3 block">
            <span class="sr-only">{g.amount}</span>
            <input
              id="amount-input"
              type="number"
              min="1"
              value={g.amounts[0]}
              class="h-12 w-full rounded-xl border border-forest/15 bg-white px-4 text-base text-forest"
            />
          </label>
        </fieldset>

        <fieldset class="mt-8">
          <legend class="text-xs font-bold uppercase tracking-[0.16em] text-forest/55">{g.designation}</legend>
          <div class="mt-4 grid gap-3" data-group="designation">
            <button type="button" data-value="general" data-label={g.general} class="designation-toggle rounded-2xl border p-4 text-left" aria-pressed="true">
              <span class="block font-semibold text-forest">{g.general}</span>
              <span class="mt-1 block text-xs leading-5 text-forest/55">{g.generalText}</span>
            </button>
            {missions.map((mission) => (
              <button
                type="button"
                data-value={mission.slug}
                data-label={mission.title[locale]}
                class="designation-toggle rounded-2xl border p-4 text-left"
                aria-pressed="false"
              >
                <span class="block font-semibold text-forest">{mission.title[locale]}</span>
                <span class="mt-1 block text-xs leading-5 text-forest/55">{mission.category[locale]}</span>
              </button>
            ))}
          </div>
        </fieldset>
      </div>

      <aside class="h-fit rounded-[2rem] bg-forest p-7 text-cream lg:sticky lg:top-28">
        <Icon name="heart-handshake" class="size-8 text-[#e6a98d]" />
        <p class="mt-7 text-xs font-bold uppercase tracking-[0.18em] text-cream/45">{g.summary}</p>
        <p class="mt-3 font-heading text-4xl font-semibold"><span id="summary-amount">${g.amounts[0]}</span></p>
        <p class="mt-2 text-sm text-cream/60">
          <span id="summary-frequency">{g.one}</span> · <span id="summary-designation">{g.general}</span>
        </p>

        <div id="give-result" class="mt-7 hidden items-start gap-3 rounded-2xl bg-white/8 p-4">
          <Icon name="check-circle" class="mt-0.5 size-5 shrink-0 text-[#e6a98d]" />
          <p class="text-sm leading-7 text-cream/75">{g.result}</p>
        </div>
        <button type="button" id="give-continue" class="btn btn-cream mt-8 h-12 w-full">{g.continue}</button>

        <p class="mt-6 flex items-start gap-2 text-xs leading-6 text-cream/45">
          <Icon name="lock" class="mt-1 size-4 shrink-0" />
          {g.secure}
        </p>
      </aside>
    </div>
  </section>
</BaseLayout>

<script>
  const root = document.getElementById('give-form');
  if (root) {
    const generalLabel = root.dataset.generalLabel ?? 'General';
    const amountInput = document.getElementById('amount-input') as HTMLInputElement | null;
    const summaryAmount = document.getElementById('summary-amount');
    const summaryFrequency = document.getElementById('summary-frequency');
    const summaryDesignation = document.getElementById('summary-designation');
    const continueBtn = document.getElementById('give-continue') as HTMLButtonElement | null;
    const resultBox = document.getElementById('give-result');

    const oneTimeLabel = root.querySelector('[data-group="frequency"] [data-value="one-time"]')?.textContent?.trim() ?? 'One time';
    const monthlyLabel = root.querySelector('[data-group="frequency"] [data-value="monthly"]')?.textContent?.trim() ?? 'Monthly';

    let designationLabel = generalLabel;

    function setPressed(group: string, value: string) {
      root?.querySelectorAll(`[data-group="${group}"] button`).forEach((btn) => {
        const isMatch = btn.getAttribute('data-value') === value;
        btn.setAttribute('aria-pressed', String(isMatch));
      });
    }

    function updateSummary() {
      if (summaryAmount && amountInput) summaryAmount.textContent = `$${amountInput.value || '0'}`;
      const activeFreq = root?.querySelector('[data-group="frequency"] [aria-pressed="true"]');
      if (summaryFrequency) {
        summaryFrequency.textContent = activeFreq?.getAttribute('data-value') === 'monthly' ? monthlyLabel : oneTimeLabel;
      }
      if (summaryDesignation) summaryDesignation.textContent = designationLabel;
    }

    root.querySelectorAll('[data-group="frequency"] button').forEach((btn) => {
      btn.addEventListener('click', () => {
        setPressed('frequency', btn.getAttribute('data-value') ?? '');
        updateSummary();
      });
    });

    root.querySelectorAll('[data-group="amount-preset"] button').forEach((btn) => {
      btn.addEventListener('click', () => {
        const value = btn.getAttribute('data-value') ?? '';
        setPressed('amount-preset', value);
        if (amountInput) amountInput.value = value;
        updateSummary();
      });
    });

    amountInput?.addEventListener('input', () => {
      root?.querySelectorAll('[data-group="amount-preset"] button').forEach((btn) => {
        btn.setAttribute('aria-pressed', String(btn.getAttribute('data-value') === amountInput.value));
      });
      updateSummary();
    });

    root.querySelectorAll('[data-group="designation"] button').forEach((btn) => {
      btn.addEventListener('click', () => {
        const value = btn.getAttribute('data-value') ?? 'general';
        designationLabel = btn.getAttribute('data-label') ?? generalLabel;
        setPressed('designation', value);
        updateSummary();
      });
    });

    continueBtn?.addEventListener('click', () => {
      resultBox?.classList.remove('hidden');
      resultBox?.classList.add('flex');
      continueBtn.classList.add('hidden');
    });

    const params = new URLSearchParams(window.location.search);
    const missionParam = params.get('mission');
    if (missionParam) {
      const target = root.querySelector(`[data-group="designation"] [data-value="${CSS.escape(missionParam)}"]`);
      if (target) (target as HTMLButtonElement).click();
    }

    updateSummary();
  }
</script>

<style>
  .give-toggle[aria-pressed='true'] {
    border-color: var(--color-forest);
    background: var(--color-forest);
    color: var(--color-cream);
  }
  .give-toggle[aria-pressed='false'] {
    border-color: color-mix(in srgb, var(--color-forest) 15%, transparent);
    background: white;
    color: var(--color-forest);
  }
  .give-toggle[aria-pressed='false']:hover {
    border-color: color-mix(in srgb, var(--color-forest) 35%, transparent);
  }

  .amount-toggle[aria-pressed='true'] {
    border-color: var(--color-clay);
    background: var(--color-clay);
    color: var(--color-cream);
  }
  .amount-toggle[aria-pressed='false'] {
    border-color: color-mix(in srgb, var(--color-forest) 15%, transparent);
    background: white;
    color: var(--color-forest);
  }

  .designation-toggle[aria-pressed='true'] {
    border-color: var(--color-forest);
    background: color-mix(in srgb, var(--color-sage) 60%, transparent);
  }
  .designation-toggle[aria-pressed='false'] {
    border-color: color-mix(in srgb, var(--color-forest) 12%, transparent);
    background: white;
  }
</style>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import ZeffyDonationForm from '@/components/ZeffyDonationForm.astro';
import { ui } from '@/i18n/ui';
import type { Locale } from '@/i18n/locales';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
const g = t.give;
---

<BaseLayout locale={locale} path="/give" title={g.eyebrow} description={g.description}>
  <PageHero eyebrow={g.eyebrow} title={g.title} description={g.description} />

  <section class="bg-white py-16" id="give-form">
    <div class="container-page">
      <div class="mx-auto max-w-2xl">
        <h2 class="sr-only">{g.formTitle}</h2>

        <ZeffyDonationForm title={g.formTitle} />

        <p class="mt-8 flex items-start justify-center gap-2 text-xs leading-6 text-forest/50">
          <Icon name="lock" class="mt-1 size-4 shrink-0" />
          <span>{g.secure}</span>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

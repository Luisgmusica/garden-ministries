---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import founders from '@/assets/about/founders.jpg';
import foundersFamily from '@/assets/about/founders-family.jpg';
import { ui } from '@/i18n/ui';
import type { Locale } from '@/i18n/locales';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
const a = t.about;
const icons = ['church', 'heart-handshake', 'network', 'sprout'] as const;
---

<BaseLayout locale={locale} path="/about" title={a.eyebrow} description={a.description}>
  <PageHero eyebrow={a.eyebrow} title={a.title} description={a.description} />
  <section class="bg-white py-16">
    <div class="container-page">
      <blockquote class="rounded-[2rem] bg-forest p-8 font-heading text-3xl font-semibold leading-tight text-cream sm:p-10 sm:text-5xl">
        &ldquo;{a.quote}&rdquo;
      </blockquote>
      <p class="mx-auto mt-12 max-w-3xl text-center text-lg leading-9 text-forest/70">{a.identity}</p>
      <div class="mt-12 grid gap-4 md:grid-cols-2">
        {a.blocks.map(([title, text], index) => (
          <article class="rounded-3xl border border-forest/10 bg-cream/55 p-6">
            <Icon name={icons[index]} class="size-6 text-clay" />
            <h2 class="mt-6 font-heading text-2xl font-semibold text-forest">{title}</h2>
            <p class="mt-3 text-sm leading-7 text-forest/65">{text}</p>
          </article>
        ))}
      </div>
      <div class="mt-16 border-t border-forest/10 pt-12">
        <div class="grid gap-10 lg:grid-cols-[1.05fr_.95fr] lg:items-center">
          {/* Founders photo: owner-provided IMG_8418 (1280×960). Replace the asset file to update it; the layout needs no change. */}
          <figure class="mx-auto w-full max-w-xl lg:mx-0">
            <Image
              src={founders}
              alt={a.foundersAlt}
              widths={[480, 720, 960, 1152]}
              sizes="(min-width: 640px) 36rem, 100vw"
              class="aspect-[4/3] w-full rounded-[2rem] object-cover"
            />
            <figcaption class="mt-3 text-sm text-forest/60">{a.foundersCaption}</figcaption>
          </figure>
          <div>
            <h2 class="font-heading text-4xl font-semibold tracking-tight text-forest sm:text-5xl">{a.peopleTitle}</h2>
            <p class="mt-5 max-w-xl text-lg leading-8 text-forest/70">{a.peopleText}</p>
            <p class="mt-8 text-xs font-bold uppercase tracking-[0.16em] text-clay">{a.legal}</p>
          </div>
        </div>
        <figure class="mt-12">
          <Image
            src={foundersFamily}
            alt={a.familyAlt}
            widths={[640, 960, 1280, 1944]}
            sizes="(min-width: 84rem) 80rem, 100vw"
            class="aspect-[3/2] w-full rounded-[2rem] object-cover"
          />
          <figcaption class="mt-3 text-sm text-forest/60">{a.familyCaption}</figcaption>
        </figure>
      </div>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import { ui } from '@/i18n/ui';
import type { Locale } from '@/i18n/locales';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
const p = t.privacy;
---

<BaseLayout locale={locale} path="/privacy" title={p.eyebrow} description={p.description}>
  <PageHero eyebrow={p.eyebrow} title={p.title} description={p.description} />
  <section class="bg-white py-16">
    <div class="mx-auto max-w-4xl px-5 lg:px-8">
      <div class="grid gap-4">
        {p.sections.map(([title, text]) => (
          <article class="rounded-3xl border border-forest/10 p-6">
            <h2 class="font-heading text-2xl font-semibold text-forest">{title}</h2>
            <p class="mt-3 text-sm leading-7 text-forest/65">{text}</p>
          </article>
        ))}
      </div>
      <p class="mt-8 rounded-2xl bg-sage/55 px-5 py-4 text-sm font-medium text-forest">{p.note}</p>
    </div>
  </section>
</BaseLayout>

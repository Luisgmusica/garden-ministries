---
import Icon from '@/components/Icon.astro';
import type { Mission } from '@/data/missions';
import { localizedPath, type Locale } from '@/i18n/locales';

interface Props {
  mission: Mission;
  locale: Locale;
}

const { mission, locale } = Astro.props;

const toneClasses: Record<Mission['tone'], string> = {
  sage: 'bg-sage/70',
  clay: 'bg-[#ead6cc]',
  gold: 'bg-[#eee3c6]',
};
---

<a
  href={localizedPath(`/missions/${mission.slug}`, locale)}
  class="group flex min-h-[320px] flex-col rounded-[1.75rem] border border-forest/10 bg-white p-6 shadow-[0_18px_55px_-42px_rgba(23,53,44,.7)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_24px_70px_-40px_rgba(23,53,44,.7)]"
>
  <div class="flex items-start justify-between">
    <span class={`grid size-12 place-items-center rounded-2xl ${toneClasses[mission.tone]} text-forest`}>
      <Icon name={mission.icon} class="size-5" />
    </span>
    <Icon name="arrow-up-right" class="size-5 text-forest/35 transition group-hover:text-clay" />
  </div>
  <p class="mt-7 text-[11px] font-bold uppercase tracking-[0.18em] text-clay">{mission.category[locale]}</p>
  <h3 class="mt-3 font-heading text-3xl font-semibold leading-tight tracking-tight text-forest">{mission.title[locale]}</h3>
  <p class="mt-4 text-sm leading-7 text-forest/65">{mission.summary[locale]}</p>
  <div class="mt-auto flex items-center justify-between border-t border-forest/10 pt-5 text-xs font-semibold text-forest/55">
    <span>{mission.location[locale]}</span>
    <span class="rounded-full bg-cream px-3 py-1.5 text-forest">{mission.status[locale]}</span>
  </div>
</a>

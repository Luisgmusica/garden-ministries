---
// Minimal, dependency-free line-icon set (24x24, stroke-based) so the site
// ships zero icon-library JS/CSS. Not a clone of any third-party icon set.
export type IconName =
  | 'heart-handshake'
  | 'users'
  | 'church'
  | 'arrow-right'
  | 'arrow-up-right'
  | 'arrow-left'
  | 'shield-check'
  | 'leaf'
  | 'sprout'
  | 'eye'
  | 'droplets'
  | 'receipt'
  | 'file-lock'
  | 'hand-heart'
  | 'repeat'
  | 'check-circle'
  | 'lock'
  | 'search-check'
  | 'file-check'
  | 'mail'
  | 'map-pin'
  | 'menu'
  | 'close'
  | 'message-heart'
  | 'building'
  | 'network';

interface Props {
  name: IconName;
  class?: string;
  [attr: string]: unknown;
}

const { name, class: className = 'size-5', ...rest } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  {...rest}
>
  {name === 'heart-handshake' && (
    <>
      <path d="M11 14 8.5 16.2a1.7 1.7 0 0 1-2.4 0l-2-2a1.7 1.7 0 0 1 0-2.4L8 8" />
      <path d="M13 10.5 15.5 8.3a1.7 1.7 0 0 1 2.4 0l2 2a1.7 1.7 0 0 1 0 2.4L16 16.2c-1 1-2.1 1.4-3.4.9L11 16.4" />
      <path d="M9 9c1.4-1.9 3-2.6 4.6-1.6M6.5 16.5 9 19" />
    </>
  )}
  {name === 'users' && (
    <>
      <circle cx="9" cy="8" r="3.2" />
      <path d="M3.5 19.5c.6-3 2.8-4.8 5.5-4.8s4.9 1.8 5.5 4.8" />
      <path d="M16 8.2a3 3 0 1 1 0 6" />
      <path d="M15 14.9c2.4.3 4.2 2 4.7 4.6" />
    </>
  )}
  {name === 'church' && (
    <>
      <path d="M12 3v3M10.3 4.7h3.4" />
      <path d="M12 8 5 12v9h14v-9z" />
      <path d="M10 21v-6h4v6" />
      <path d="M5 21h14" />
    </>
  )}
  {name === 'arrow-right' && (
    <>
      <path d="M4 12h15.5" />
      <path d="M14 6.5 19.5 12 14 17.5" />
    </>
  )}
  {name === 'arrow-up-right' && (
    <>
      <path d="M7 17 17 7" />
      <path d="M9 7h8v8" />
    </>
  )}
  {name === 'arrow-left' && (
    <>
      <path d="M20 12H4.5" />
      <path d="M10 6.5 4.5 12 10 17.5" />
    </>
  )}
  {name === 'shield-check' && (
    <>
      <path d="M12 3.2 19 6v6.2c0 4.4-2.9 7.4-7 8.6-4.1-1.2-7-4.2-7-8.6V6z" />
      <path d="m9 12 2 2 4-4.2" />
    </>
  )}
  {name === 'leaf' && (
    <path d="M6 20c-1.2-6.5 2-11.8 12-13-1 8.5-4.8 12.4-12 13Zm0 0c.5-3.6 2-6.3 5-8.2" />
  )}
  {name === 'sprout' && (
    <>
      <path d="M12 21v-8" />
      <path d="M12 13c0-4 2.5-6.2 7-6.3-.4 4.3-2.8 6.3-7 6.3Z" />
      <path d="M12 13c0-3.2-2-4.9-5.5-5-.3 3.4 2.1 5 5.5 5Z" />
    </>
  )}
  {name === 'eye' && (
    <>
      <path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12Z" />
      <circle cx="12" cy="12" r="2.6" />
    </>
  )}
  {name === 'droplets' && (
    <>
      <path d="M13 3.5s5 6 5 9.6a5 5 0 0 1-10 0C8 9.5 13 3.5 13 3.5Z" />
      <path d="M6.5 12.8a2.7 2.7 0 0 1-2.4-3.9" />
    </>
  )}
  {name === 'receipt' && (
    <>
      <path d="M6 3h12v18l-2.5-1.6L13 21l-2.5-1.6L8 21l-2-1.6Z" />
      <path d="M8.5 8h7M8.5 11.5h7M8.5 15h4.5" />
    </>
  )}
  {name === 'file-lock' && (
    <>
      <path d="M7 3h7l4 4v14H7Z" />
      <rect x="9.6" y="12.5" width="6" height="5" rx="1" />
      <path d="M10.8 12.5v-1.7a1.7 1.7 0 1 1 3.4 0v1.7" />
    </>
  )}
  {name === 'hand-heart' && (
    <>
      <path d="M3.5 13.5h4l3 1.3h4.7a1.4 1.4 0 0 0 0-2.8h-3.6" />
      <path d="M7.5 13.5 10 11c1-.8 2.2-.8 3.2 0l3.8 3" />
      <path d="M3.5 12.2v6.3h4v-6.3Z" />
      <path d="M16.7 6.7c1.2-1.4 3.4-.5 3.4 1.2 0 1.5-1.7 2.8-3.4 4-1.7-1.2-3.4-2.5-3.4-4 0-1.7 2.2-2.6 3.4-1.2Z" />
    </>
  )}
  {name === 'repeat' && (
    <>
      <path d="M4 9.5a5.5 5.5 0 0 1 5.5-5h8" />
      <path d="M15 2 17.5 4.5 15 7" />
      <path d="M20 14.5a5.5 5.5 0 0 1-5.5 5h-8" />
      <path d="M9 22 6.5 19.5 9 17" />
    </>
  )}
  {name === 'check-circle' && (
    <>
      <circle cx="12" cy="12" r="8.7" />
      <path d="m8.3 12.3 2.6 2.6 4.8-5.4" />
    </>
  )}
  {name === 'lock' && (
    <>
      <rect x="5" y="10.5" width="14" height="9.5" rx="1.6" />
      <path d="M8 10.5V7.7a4 4 0 1 1 8 0v2.8" />
    </>
  )}
  {name === 'search-check' && (
    <>
      <circle cx="10.5" cy="10.5" r="6.8" />
      <path d="m20 20-4.3-4.3" />
      <path d="m7.7 10.5 2 2 3.3-3.6" />
    </>
  )}
  {name === 'file-check' && (
    <>
      <path d="M7 3h7l4 4v14H7Z" />
      <path d="m9.5 13.5 2 2 3.5-4" />
    </>
  )}
  {name === 'mail' && (
    <>
      <rect x="3.2" y="5.5" width="17.6" height="13" rx="1.8" />
      <path d="m4 6.7 8 6.3 8-6.3" />
    </>
  )}
  {name === 'map-pin' && (
    <>
      <path d="M12 21.5s7-6.2 7-12A7 7 0 0 0 5 9.5c0 5.8 7 12 7 12Z" />
      <circle cx="12" cy="9.5" r="2.4" />
    </>
  )}
  {name === 'menu' && (
    <>
      <path d="M3.5 6.5h17" />
      <path d="M3.5 12h17" />
      <path d="M3.5 17.5h17" />
    </>
  )}
  {name === 'close' && (
    <>
      <path d="m5.5 5.5 13 13" />
      <path d="m18.5 5.5-13 13" />
    </>
  )}
  {name === 'message-heart' && (
    <>
      <path d="M4 5.5h16v11H9l-5 4z" />
      <path d="M12 8.6c1-1.2 3-.8 3 .8 0 1.2-1.4 2.1-3 3.1-1.6-1-3-1.9-3-3.1 0-1.6 2-2 3-.8Z" />
    </>
  )}
  {name === 'building' && (
    <>
      <rect x="5" y="3.5" width="10" height="17" rx="0.6" />
      <path d="M15 9h4v11.5h-4" />
      <path d="M8 7.3h.01M11.5 7.3h.01M8 11h.01M11.5 11h.01M8 14.7h.01M11.5 14.7h.01" stroke-width="2.4" />
    </>
  )}
  {name === 'network' && (
    <>
      <circle cx="12" cy="5" r="2.2" />
      <circle cx="5" cy="18" r="2.2" />
      <circle cx="19" cy="18" r="2.2" />
      <path d="M10.4 6.7 6.7 15.9M13.6 6.7l3.7 9.2M7.3 18h9.4" />
    </>
  )}
</svg>

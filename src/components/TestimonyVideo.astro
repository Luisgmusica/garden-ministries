---
import { Image } from 'astro:assets';
import Icon from '@/components/Icon.astro';
import type { Testimony } from '@/data/testimonies';
import { ui } from '@/i18n/ui';
import type { Locale } from '@/i18n/locales';

interface Props {
  testimony: Testimony;
  /** Zero-based position, used only for the accessible name ("Testimony 1 of 3"). */
  index: number;
  total: number;
  locale: Locale;
}

const { testimony, index, total, locale } = Astro.props;
const h = ui[locale].home;

const seconds = Math.round(testimony.durationSec);
const duration = `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, '0')}`;
const fill = (template: string) =>
  template.replace('{n}', String(index + 1)).replace('{total}', String(total)).replace('{duration}', duration);

const tracks = Object.entries(testimony.captions ?? {}).map(([lang, src]) => ({
  lang,
  src,
  label: lang === 'es' ? 'Español' : 'English',
  default: lang === locale,
}));
const posterWidths = [240, 360, 480, 720].filter((w) => w <= testimony.width);
---

<figure class="testimony">
  {/*
    Poster-first: no video bytes are requested until the visitor activates the link. With JavaScript the
    link is swapped for an inline video element that starts playing; without it, the browser opens the MP4.
  */}
  <a
    href={testimony.src}
    class="group relative block overflow-hidden rounded-[1.6rem] bg-forest focus-visible:outline-offset-[-4px]"
    aria-label={fill(h.testimonyPlay)}
    data-testimony-play
    data-src={testimony.src}
    data-width={testimony.width}
    data-height={testimony.height}
    data-label={fill(h.testimonyVideoLabel)}
    data-tracks={JSON.stringify(tracks)}
  >
    <Image
      src={testimony.poster}
      alt=""
      widths={posterWidths}
      sizes="(min-width: 1024px) 15rem, (min-width: 768px) 30vw, 68vw"
      class="aspect-[9/16] w-full object-cover"
    />
    <span class="absolute bottom-4 left-4 flex items-center gap-2" aria-hidden="true">
      <span class="grid size-12 place-items-center rounded-full bg-cream text-forest shadow-lg transition group-hover:bg-white">
        <Icon name="play" class="size-5 translate-x-px" />
      </span>
      <span class="rounded-full bg-forest/80 px-2.5 py-1 text-xs font-semibold text-cream">{duration}</span>
    </span>
  </a>
  {
    (testimony.name || testimony.summary) && (
      <figcaption class="mt-3 text-sm leading-6 text-forest/70">
        {testimony.name && <span class="block font-semibold text-forest">{testimony.name}</span>}
        {testimony.summary && <span class="block">{testimony.summary[locale]}</span>}
      </figcaption>
    )
  }
</figure>

<script>
  type Track = { lang: string; src: string; label: string; default: boolean };

  document.querySelectorAll<HTMLAnchorElement>('[data-testimony-play]').forEach((link) => {
    link.addEventListener('click', (event) => {
      // Let modified clicks open the file in a new tab as usual.
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return;
      event.preventDefault();

      const video = document.createElement('video');
      video.controls = true;
      video.playsInline = true;
      video.preload = 'auto';
      video.dataset.testimonyVideo = '';
      video.className = 'aspect-[9/16] w-full rounded-[1.6rem] bg-forest object-contain';
      video.width = Number(link.dataset.width);
      video.height = Number(link.dataset.height);
      video.setAttribute('aria-label', link.dataset.label ?? '');
      const poster = link.querySelector('img');
      if (poster?.currentSrc) video.poster = poster.currentSrc;

      const source = document.createElement('source');
      source.src = link.dataset.src ?? link.href;
      source.type = 'video/mp4';
      video.append(source);

      for (const track of JSON.parse(link.dataset.tracks ?? '[]') as Track[]) {
        const element = document.createElement('track');
        element.kind = 'captions';
        element.src = track.src;
        element.srclang = track.lang;
        element.label = track.label;
        element.default = track.default;
        video.append(element);
      }

      // Only one testimony plays at a time.
      video.addEventListener('play', () => {
        document.querySelectorAll<HTMLVideoElement>('video[data-testimony-video]').forEach((other) => {
          if (other !== video) other.pause();
        });
      });

      link.replaceWith(video);
      video.focus();
      // Started by the visitor's click; if the browser still blocks playback, the controls remain.
      video.play().catch(() => {});
    });
  });
</script>
